{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/co-explore/trajectory.schema.json",
  "title": "CoExplore trajectory",
  "type": "object",
  "required": [
    "session_id",
    "language",
    "mode",
    "seed",
    "started_at",
    "budget",
    "participants",
    "steps",
    "checkpoints"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "zh-CN"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "guided",
        "relay",
        "timed",
        "comparison"
      ]
    },
    "seed": {
      "type": "object",
      "required": [
        "description",
        "selection_method"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection_method": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "budget": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "steps",
            "minutes"
          ]
        },
        "value": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "human",
          "ai"
        ]
      },
      "uniqueItems": true
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "timestamp",
          "actor",
          "source_type",
          "source_title",
          "observation",
          "label",
          "uncertainty",
          "next_hop_reason"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string",
            "enum": [
              "human",
              "ai"
            ]
          },
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "source_title": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "unfamiliar_detail": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "enum": [
              "observation",
              "inference",
              "speculation"
            ]
          },
          "uncertainty": {
            "type": "string"
          },
          "next_hop_reason": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "after_step",
          "route_summary",
          "unfamiliar_observations",
          "warnings",
          "open_routes"
        ],
        "properties": {
          "after_step": {
            "type": "integer",
            "minimum": 1
          },
          "route_summary": {
            "type": "string"
          },
          "unfamiliar_observations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "open_routes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "human_intervention": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "retrospective": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
